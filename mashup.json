{
  "id": "sigf/um-gta5-passthrough",
  "version": "0.1.0",
  "name": "Minecraft x GTA V Passthrough",
  "tagline": "Real Minecraft 26.3 drawn into GTA V story mode: build with blocks that become GTA props, TNT and creepers blow up both worlds, elytra over Los Santos.",
  "how_to_play": [
    "Play Steve inside GTA V story mode: blocks you place become GTA props, and TNT and creepers blow up in both games.",
    "Left and right mouse are Minecraft's attack and use, wheel or 1-9 the hotbar, Space takes off with the elytra.",
    "F7 turns the passthrough off and on, F8 re-levels the Minecraft ground; walking, driving and the camera stay GTA's.",
    "Press Play: Minecraft opens its passthrough world by itself; leave it open, then pick Story Mode in GTA V.",
    "Wait for Minecraft passthrough connected; in a new game press F7 to play the prologue, then F7 again in Los Santos."
  ],
  "kind": "passthrough",
  "games": [
    {
      "game": "gta5",
      "role": "host",
      "label": "GTA V Legacy",
      "engine": "GTA V Legacy (RAGE, story mode) + ScriptHookV ASI MCPassthrough (C++) + ReShade add-on",
      "apps": {
        "steam": "271590"
      },
      "builds": {
        "steam": [
          "1.0.3889.0"
        ]
      },
      "runtime": "GTA V Legacy build 3889 (GTA5.exe); Enhanced is not supported"
    },
    {
      "game": "minecraft",
      "role": "guest",
      "label": "Minecraft",
      "engine": "Minecraft Java 26.3 + Fabric mod passthrough (Java)",
      "mc": "26.3",
      "loader": "fabric@0.19.5",
      "java": "25"
    }
  ],
  "requires": [
    {
      "id": "scripthookv",
      "page": "https://www.dev-c.com/gtav/scripthookv/",
      "license": "Alexander Blade: free, not redistributable",
      "note": "ScriptHookV for your GTA V Legacy build (3889.0 for build 3889): copy ScriptHookV.dll and dinput8.dll from its bin folder into the GTA V folder"
    },
